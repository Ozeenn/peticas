# Copie para deploy/oci/.env. Nunca use o .env local em produção.
# Hostname sem https://, caminho ou porta; DNS deve apontar ao IP público da VM.
SITE_HOST=
ACME_EMAIL=
# Gere valores independentes: python3 -c "import secrets; print(secrets.token_hex(32))"
# Use somente letras e números na senha, pois ela compõe a URL PostgreSQL.
POSTGRES_PASSWORD=
ADMIN_SETUP_KEY=
# Para enviar uma imagem já construída, use um tag de release e up --no-build.
PETICAS_APP_IMAGE=peticas-oci-app:latest
# Opcional: gateway HTTPS externo já configurado; vazio desativa os envios reais.
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
