PORT=4173
# Configure uma chave aleatória longa para habilitar o primeiro administrador.
ADMIN_SETUP_KEY=

# Gateway Python: https://seu-gateway/messages na produção.
# No servidor local, pode usar http://127.0.0.1:8001/messages.
WHATSAPP_WEBHOOK_URL=
# Mesmo segredo de PETICAS_GATEWAY_TOKEN no gateway (mínimo 32 caracteres).
WHATSAPP_WEBHOOK_TOKEN=
# Aliases resolvidos pelo gateway; telefones ficam na configuração Python.
WHATSAPP_OWNER_TARGET=owner
WHATSAPP_VOLUNTEERS_TARGET=volunteers
