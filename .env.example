PORT=4173
# PostgreSQL no Docker. Use senha aleatória longa com letras e números.
POSTGRES_PASSWORD=
SEED_DEMO=true
# Execução Python sem Docker: configure a URL do seu PostgreSQL.
DATABASE_URL=
# Configure uma chave aleatória longa para habilitar o primeiro administrador.
ADMIN_SETUP_KEY=

# Gateway Python: https://seu-gateway/messages na produção.
# No servidor local, pode usar http://127.0.0.1:8001/messages.
WHATSAPP_WEBHOOK_URL=
# Mesmo segredo de PETICAS_GATEWAY_TOKEN no gateway (mínimo 32 caracteres).
WHATSAPP_WEBHOOK_TOKEN=
# Aliases resolvidos pelo gateway; telefones ficam na configuração Python.
WHATSAPP_OWNER_TARGET=owner
WHATSAPP_VOLUNTEERS_TARGET=volunteers

# Gateway opcional do Compose: WHATSAPP_WEBHOOK_URL=http://gateway:8001/messages
# Para ativar: docker compose --profile whatsapp up --build -d
WHATSAPP_DRY_RUN=true
WHATSAPP_OWNER_NUMBERS=
WHATSAPP_VOLUNTEERS_NUMBERS=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_MESSAGE_MODE=text
WHATSAPP_OWNER_TEMPLATE=
WHATSAPP_VOLUNTEERS_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_TEMPLATE_BODY_VALUE=
