# Copie para .env nesta pasta. Nunca versione credenciais.
# Mesmo segredo de WHATSAPP_WEBHOOK_TOKEN no backend (mínimo 32 caracteres).
PETICAS_GATEWAY_TOKEN=
# Simulação não envia para a Meta e NÃO conclui os trabalhos na fila do Peticas.
WHATSAPP_DRY_RUN=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Versão ativa da Graph API exibida no painel/documentação da Meta (ex.: vNN.N).
WHATSAPP_GRAPH_VERSION=
# Telefones com código do país, somente dígitos. Lista separada por vírgulas.
WHATSAPP_OWNER_NUMBERS=
WHATSAPP_VOLUNTEERS_NUMBERS=
# template: aviso genérico com um parâmetro de corpo (link do sistema).
# text: conteúdo completo, somente quando permitido pela janela de atendimento.
WHATSAPP_MESSAGE_MODE=template
WHATSAPP_OWNER_TEMPLATE=
WHATSAPP_VOLUNTEERS_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_TEMPLATE_BODY_VALUE=
# Banco exclusivo do gateway, em volume persistente na produção.
WHATSAPP_GATEWAY_DB=data/whatsapp-gateway.sqlite
